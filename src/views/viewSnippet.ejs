<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Snippet</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .snippet-container {
            background-color: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            width: 600px;
            text-align: center;
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
            align-self: center;
        }

        p {
            margin: 50px 0;
            font-size: 18px;
        }

        .actions {
            text-align: center;
            margin-top: 20px;
        }

        a {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            border-radius: 5px;
            text-decoration: none;
            margin: 5px;
        }

        a:hover {
            background-color: #45a049;
        }

        .description {
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

        .description p {
            margin: 10px;
            text-align: center;
        }

        .code {
            margin-bottom: 10px;
            align-items: center;
            height: auto;
        }
        .code p {
            margin-top: 20px;
            margin-bottom: 0px;
            text-align: center;
        }
        pre {
            background-color: #f4f4f4;
            padding: 10px;
            border: 1px solid black;
            border-radius: 5px;
            border-color: black;
            overflow-x: auto;
            word-wrap: break-word;
            max-width: 100%;
            height: auto;
        }
        code {
            display: block;
            font-size: 16px;
            overflow-x: break-word;
            max-width: 600px;
            min-height: 50px;
        }
        .logout-button {
            position: absolute;
            top: 20px;
            right: 20px;
            padding: 10px 20px;
            background-color: #ff4c4c;
            color: white;
            border-radius: 5px;
            text-decoration: none;
        }

        .logout-button:hover {
            background-color: #e04343;
        }
        .register-button {
            position: absolute;
            top: 20px;
            right: 130px;
            padding: 10px 20px;
            background-color: #ff4c4c;
            color: white;
            border-radius: 5px;
            text-decoration: none;
        }

        .register-button:hover {
            background-color: #e04343;
        }
    </style>
</head>
<body>
    <% if (username === 'guest') { %>
        <a href="/" class="logout-button">Log In</a>
        <a href="/register" class="register-button">Register</a>
        <% } else { %>
        <a href="/logout" class="logout-button">Log Out</a>
        <% } %>
    <div class="snippet-container">
        <h2>Snippet Details</h2>
        <div class="description">
            <p><strong>Description:</strong></p>
            <p><%= snippet.description %></p>
        </div>
            <hr>
        <div class="code">
            <p><strong>Code:</strong></p> <br>
            <pre><code><%= snippet.snippet %></code></pre>
        </div>
        
        <div class="actions">
            <% if (username === snippet.createdBy) { %>
            <a href="/snippets/<%= snippet.id %>/edit">Edit</a>
            <a href="/snippets/<%= snippet.id %>/delete">Delete</a>
            <% } %>
            <a href="/home">Back to List</a>
        </div>
    </div>
</body>
</html>
